# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES - LI-LO
# ===========================================
# Copy this file to .env.production.local and fill in your production values

# ---------------------------------------------
# 🔒 SUPABASE CONFIGURATION
# ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://mrrlohamkffxfiwspkki.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here
SUPABASE_ACCESS_TOKEN=your_production_access_token_here

# ---------------------------------------------
# 💳 STRIPE CONFIGURATION (PRODUCTION KEYS)
# ---------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
STRIPE_SECRET_KEY=sk_live_your_production_secret_key

# Webhook endpoint secret (set after creating webhook)
# Webhook URL: https://your-domain.com/api/stripe/webhook
# Events to listen: checkout.session.completed, payment_intent.succeeded, etc.
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# ---------------------------------------------
# 📧 EMAIL CONFIGURATION (GMAIL SMTP)
# ---------------------------------------------
# Using Gmail with App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
RESEND_FROM_EMAIL=your_email@gmail.com

# Alternative: Using Resend API
# RESEND_API_KEY=re_your_production_api_key
# RESEND_FROM_EMAIL=noreply@your-domain.com

# ---------------------------------------------
# 📊 ANALYTICS CONFIGURATION
# ---------------------------------------------
# Google Analytics 4
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID

# Plausible Analytics (Alternative)
# Get from: https://plausible.io/
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# ---------------------------------------------
# 🚨 MONITORING & ERROR TRACKING
# ---------------------------------------------
# Sentry Configuration
# Get from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://your_public_key@sentry.io/your_project_id
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_organization_name
SENTRY_PROJECT=your_project_name

# ---------------------------------------------
# 🔐 SECURITY & AUTHENTICATION
# ---------------------------------------------
# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_super_secure_random_string_here
NEXTAUTH_URL=https://your-domain.com

# Cron Job Secret (for scheduled tasks)
CRON_SECRET=your_secure_cron_secret_here

# ---------------------------------------------
# 🌐 APPLICATION CONFIGURATION
# ---------------------------------------------
# Production URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Environment
NODE_ENV=production

# ---------------------------------------------
# 🎯 OPTIONAL: EXTERNAL APIs
# ---------------------------------------------
# StockX API (if using for inventory sync)
# STOCKX_API_KEY=your_stockx_api_key

# OpenAI API (if using AI features)
# OPENAI_API_KEY=sk-your_openai_api_key

# ---------------------------------------------
# ⚡ PERFORMANCE & CACHING
# ---------------------------------------------
# Redis Configuration (if using)
# REDIS_URL=redis://user:password@host:6379

# CDN Configuration
# CDN_URL=https://cdn.your-domain.com

# ---------------------------------------------
# 📝 DEPLOYMENT SPECIFIC
# ---------------------------------------------
# Vercel Configuration
# VERCEL_ENV=production
# VERCEL_URL=your-domain.vercel.app

# Database Connection Pooling
# DATABASE_POOL_SIZE=25

# ---------------------------------------------
# 🔍 SEARCH & INDEXING
# ---------------------------------------------
# Algolia (if using for search)
# NEXT_PUBLIC_ALGOLIA_APP_ID=your_app_id
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_search_key
# ALGOLIA_ADMIN_KEY=your_admin_key

# ===========================================
# IMPORTANT PRODUCTION CHECKLIST:
# ===========================================
# ✅ Replace all placeholder values with real production values
# ✅ Never commit .env.production.local to git
# ✅ Ensure all API keys are production keys (not test)
# ✅ Verify webhook URLs point to production domain
# ✅ Test email configuration with real sends
# ✅ Confirm analytics tracking codes are correct
# ✅ Set up proper CORS and security headers
# ✅ Enable rate limiting on all API endpoints
# ✅ Configure proper backup strategies
# ✅ Set up monitoring alerts (uptime, errors, performance)
# ===========================================